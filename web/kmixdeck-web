class Bridge:
    def __init__(self, token):
        self.token = token
        self.clients = set()
        self.aloop = None
        self.daemon = Daemon(self._emit_from_bus)

    def _emit_from_bus(self, msg):
        if self.aloop: self.aloop.call_soon_threadsafe(self._broadcast, msg)

    def _broadcast(self, msg):
        data = json.dumps(msg, separators=(",", ":"))
        for ws in list(self.clients):
            try: asyncio.ensure_future(ws.send(data))
            except Exception: self.clients.discard(ws)  # noqa: BLE001

    async def handle(self, ws):
        try:
            first = json.loads(await asyncio.wait_for(ws.recv(), 10))
            if first.get("op") != "hello": await ws.close(4000, "hello first"); return
            if self.token and not secrets.compare_digest(str(first.get("token", "")), self.token):
                await ws.close(4001, "bad token"); return
        except Exception:  # noqa: BLE001
            await ws.close(4000, "hello first"); return
        self.clients.add(ws)
        await ws.send(json.dumps({"op": "snapshot", "state": self.daemon.state}, separators=(",", ":")))
        try:
            async for raw in ws:
                try: msg = json.loads(raw)
                except ValueError: continue
                if not isinstance(msg, dict): continue
                op, rid = msg.get("op"), msg.get("id")
                fut = self.aloop.create_future()
                def done(ok, val, fut=fut): self.aloop.call_soon_threadsafe(fut.set_result, (ok, val))
                try:
                    if op == "set":
                        self.daemon.set_property(msg["path"], msg["property"], msg["value"], done)
                    elif op == "call":
                        self.daemon.call_method(msg["path"], msg["method"], msg.get("args", []), done)
                    else:
                        await ws.send(json.dumps({"op": "error", "id": rid, "message": f"unknown op {op!r}"})); continue
                except (KeyError, TypeError) as e:   # malformed frame: answer, do not drop the client (a stale tab must not kill the session)
                    await ws.send(json.dumps({"op": "error", "id": rid, "message": f"malformed {op} frame: {e!r}"})); continue
                ok, val = await fut
                await ws.send(json.dumps({"op": "result", "id": rid, "ok": True, "value": val} if ok else
                                         {"op": "error", "id": rid, "message": val}, separators=(",", ":")))
        finally:
            self.clients.discard(ws)

    async def http(self, connection, request):
        """Static files for anything that is not a WebSocket upgrade."""
        if request.headers.get("Upgrade", "").lower() == "websocket":
            # Same-origin only. A browser always sends Origin on a WebSocket upgrade; a page from another site (or a
            # local file) must not be able to drive the mixer just because the bridge is on localhost without a token.
            # Non-browser clients (tests, scripts) send no Origin and are allowed — the token is their gate on the LAN.
            origin, host = request.headers.get("Origin"), request.headers.get("Host", "")
            if origin is not None and origin.lower() not in (f"http://{host}".lower(), f"https://{host}".lower()):
                return connection.respond(HTTPStatus.FORBIDDEN, "cross-origin WebSocket refused\n")
            return None
        path = request.path.split("?", 1)[0]
        if path == "/": path = "/index.html"
        target = (WEB_DIR / path.lstrip("/")).resolve()
        if not str(target).startswith(str(WEB_DIR.resolve())) or not target.is_file():
            return connection.respond(HTTPStatus.NOT_FOUND, "not found\n")
        ctype = {".html": "text/html; charset=utf-8", ".js": "text/javascript", ".css": "text/css", ".json": "application/json",
                 ".svg": "image/svg+xml", ".png": "image/png"}.get(target.suffix, "application/octet-stream")
        body = target.read_bytes()
        headers = Headers([("Content-Type", ctype), ("Content-Length", str(len(body))), ("Cache-Control", "no-cache")])
        return Response(HTTPStatus.OK.value, HTTPStatus.OK.phrase, headers, body)

    async def serve(self, host, port, ready=None, play=None):
        self.aloop = asyncio.get_running_loop()
        threading.Thread(target=self.daemon.run, daemon=True, name="gio-bus").start()
        # do not accept browsers before the first look at the bus is done — a tab that connects in that window would
        # get an empty "disconnected" snapshot although the daemon is right there (test_web, first run)
        for _ in range(100):
            if self.daemon.settled: break
            await asyncio.sleep(0.05)
        if play: start_play_server(play[0], self.daemon, play[1], play[2])   # CT-10, after the first look at the bus
        async with serve(self.handle, host, port, process_request=self.http, max_size=1 << 20) as server:
            actual = server.sockets[0].getsockname()[1]
            print(f"kmixdeck-web: http://{host}:{actual}/" + (f"#token={self.token}" if self.token else ""), flush=True)
            if ready: ready(actual)
            stop = self.aloop.create_future()
            for s in (signal.SIGINT, signal.SIGTERM): self.aloop.add_signal_handler(s, lambda: stop.done() or stop.set_result(None))
            await stop


def load_or_make_token(name="web-token"):
    d = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "kmixdeck"; d.mkdir(parents=True, exist_ok=True)
    f = d / name
    if f.exists(): return f.read_text().strip()
    # created 0600 from the first byte on (no window in which another user could read it)
    fd = os.open(f, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    tok = secrets.token_urlsafe(24)
    with os.fdopen(fd, "w") as fh: fh.write(tok + "\n")
    return tok


