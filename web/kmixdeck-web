# CT-10 play endpoint (ADR 0016). Plain stdlib HTTP in its own threads: the websockets server above only does GET.
SLUG_RE = re.compile(r"^/channel/([A-Za-z0-9_-]{1,64})/play$")
# D-Bus error name of a refused Channel.Play → HTTP status. Anything else is a bad request (400).
PLAY_ERROR_STATUS = {
    "org.kmixdeck1.Error.PlaybackOff": 409,
    "org.kmixdeck1.Error.NotFound": 404,
    "org.kmixdeck1.Error.QueueFull": 503,
    "org.freedesktop.DBus.Error.ServiceUnknown": 503,
    "org.freedesktop.DBus.Error.NameHasNoOwner": 503,
    "org.freedesktop.DBus.Error.NoReply": 503,
}
# Uploads held in RAM at once, over all channels (memory bound: this × --play-max-bytes). The queue limit per channel
# is the daemon's alone (Player::kQueueLimit, answered as QueueFull → 503); the bridge does not keep a copy of it.
MAX_CONCURRENT_PLAYS = 8


class PlayServer(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def __init__(self, addr, daemon, token, max_bytes):
        super().__init__(addr, PlayHandler)
        self.kd, self.token, self.max_bytes = daemon, token, max_bytes
        self.slots = threading.BoundedSemaphore(MAX_CONCURRENT_PLAYS)


class PlayHandler(BaseHTTPRequestHandler):
    server_version = "kmixdeck-play"
    protocol_version = "HTTP/1.1"
    timeout = 30                    # a client that stops sending the body mid-way does not hold a thread forever

    def log_message(self, fmt, *args):   # one line per request on stderr = the journal; no body, no token
        sys.stderr.write("kmixdeck-web play: %s %s\n" % (self.address_string(), fmt % args))

    def _json(self, code, obj):
        body = (json.dumps(obj, separators=(",", ":")) + "\n").encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(body)
        self.close_connection = True

    def _err(self, code, msg): self._json(code, {"ok": False, "error": msg})

    def do_GET(self):
        if urlsplit(self.path).path == "/healthz":
            return self._json(200, {"ok": True}) if self.server.kd.on_bus else self._err(503, "the kmixdeck daemon is not on the bus")
        self._err(404, "not found")

    def do_POST(self):
        url = urlsplit(self.path)
        m = SLUG_RE.match(url.path)
        # Everything below is decided from the request line and the headers. The body is read only when the
        # request will be played — a wrong token, an unknown channel or a full queue never costs an upload.
        auth = self.headers.get("Authorization", "")
        given = auth[7:].strip() if auth[:7].lower() == "bearer " else ""
        if not secrets.compare_digest(given.encode(), self.server.token.encode()):
            return self._err(401, "bad or missing play token")
        if not m: return self._err(404, "not found: POST /channel/<slug>/play")
        kd = self.server.kd
        if not kd.on_bus: return self._err(503, "the kmixdeck daemon is not on the bus")
        slug = m.group(1)
        ch = kd.channel(slug)
        if ch is None: return self._err(404, f"no channel '{slug}'")
        if not ch.get("Playback"):
            return self._err(409, f"playback is off for channel '{slug}' — turn it on with `kmixdeck channel playback {slug} on`")
        if "chunked" in self.headers.get("Transfer-Encoding", "").lower():
            return self._err(411, "chunked bodies are not accepted; send Content-Length")
        cl = self.headers.get("Content-Length")
        if cl is None: return self._err(411, "Content-Length required")
        try: length = int(cl)
        except ValueError: return self._err(400, "bad Content-Length")
        if length <= 0: return self._err(400, "empty body")
        if length > self.server.max_bytes: return self._err(413, f"body too large: {length} > {self.server.max_bytes} bytes")
        if not self.server.slots.acquire(blocking=False):
            return self._err(503, "too many play requests in flight")
        try:
            self._play(slug, length, parse_qs(url.query).get("title", [""])[0] or f"web: {slug}")   # parse_qs decodes already
        finally:
            self.server.slots.release()

    def _play(self, slug, length, title):
        kd = self.server.kd
        # RAM only: the clip never touches a disk (ADR 0016, and the host's disk-wear rule).
        fd = os.memfd_create("kmixdeck-play", os.MFD_CLOEXEC)
        try:
            left = length
            while left > 0:
                chunk = self.rfile.read(min(left, 1 << 16))
                if not chunk: return self._err(400, f"body ended after {length - left} of {length} bytes")
                os.write(fd, chunk); left -= len(chunk)
            os.lseek(fd, 0, os.SEEK_SET)
            try:
                tid, w = kd.play(slug, fd, title[:200])
            except GLib.Error as e:
                name = Gio.DBusError.get_remote_error(e) or ""
                Gio.DBusError.strip_remote_error(e)
                code = PLAY_ERROR_STATUS.get(name, 400)
                return self._err(code, "the kmixdeck daemon is not on the bus" if code == 503 and name.startswith("org.freedesktop") else e.message)
        finally:
            os.close(fd)   # the daemon holds its own dup now
        # Block until the track ended. Meanwhile watch the client: a client that gave up (timeout, Ctrl-C) must not
        # have its clip played late — stop it, queued or sounding.
        sock = self.connection
        while not w["event"].wait(0.2):
            if self._client_gone(sock):
                kd.forget(tid)
                try: kd.stop_playback(slug, tid)
                except GLib.Error: pass
                self.close_connection = True
                return
        result = w["result"]
        if result is None: return self._err(503, "the kmixdeck daemon left the bus before the track ended")
        code = 200 if result == "played" else 410 if result == "stopped" else 422
        self._json(code, {"ok": result == "played", "id": tid, "result": result})

    @staticmethod
    def _client_gone(sock):
        """True once the peer closed (EOF) or reset. A client sends nothing after its body, so readable = gone."""
        try:
            r, _w, x = select.select([sock], [], [sock], 0)
            if x: return True
            if not r: return False
            return sock.recv(1, socket.MSG_PEEK | socket.MSG_DONTWAIT) == b""
        except (BlockingIOError, InterruptedError):
            return False
        except OSError:
            return True


def start_play_server(spec, daemon, token, max_bytes):
    host, _, port = spec.rpartition(":")
    if not host or not port.isdigit(): sys.exit(f"kmixdeck-web: --play wants HOST:PORT, got {spec!r}")
    srv = PlayServer((host.strip("[]"), int(port)), daemon, token, max_bytes)
    threading.Thread(target=srv.serve_forever, daemon=True, name="play-http").start()
    h, p = srv.server_address[:2]
    print(f"kmixdeck-web: play endpoint http://{h}:{p}/channel/<slug>/play", flush=True)
    return srv


def main(argv=None):
    ap = argparse.ArgumentParser(prog="kmixdeck-web", description=__doc__.split("\n")[0])
    ap.add_argument("--lan", action="store_true", help="bind every interface (requires the token; default: localhost only)")
    ap.add_argument("--port", type=int, default=int(os.environ.get("KMIXDECK_WEB_PORT", "7420")), help="0 = pick a free port")
    ap.add_argument("--token", help="override the stored token (testing)")
    ap.add_argument("--play", metavar="HOST:PORT", help="CT-10: also listen for POST /channel/<slug>/play (own token, opt-in)")
    ap.add_argument("--play-token", help="override the stored play token (testing)")
    ap.add_argument("--play-max-bytes", type=int, default=64 << 20, help="largest accepted upload (default 64 MiB)")
    a = ap.parse_args(argv)
    host = "0.0.0.0" if a.lan else "127.0.0.1"
    token = a.token if a.token is not None else (load_or_make_token() if a.lan else "")
    if a.lan: print("kmixdeck-web: listening on the LAN — anyone with the token controls your audio; keep it private.", file=sys.stderr, flush=True)
    play = None
    if a.play:
        ptok = a.play_token if a.play_token is not None else load_or_make_token("play-token")
        if not ptok: sys.exit("kmixdeck-web: the play endpoint needs a token")
        play = (a.play, ptok, a.play_max_bytes)
    asyncio.run(Bridge(token).serve(host, a.port, play=play))


if __name__ == "__main__":
    main()
