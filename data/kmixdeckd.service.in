[Unit]
Description=kmixdeck audio mixer service
Documentation=https://github.com/TensorRaya/kmixdeck
# Same lifecycle as pipewire-pulse.service: live and die with PipeWire.
BindsTo=pipewire.service
After=pipewire.service pipewire-session-manager.service dbus.service
Wants=pipewire.service pipewire-session-manager.service

[Service]
Type=dbus
BusName=org.kmixdeck1
ExecStart=@KDE_INSTALL_FULL_LIBEXECDIR@/kmixdeckd
Restart=on-failure
RestartSec=1
Slice=session.slice

[Install]
WantedBy=default.target
