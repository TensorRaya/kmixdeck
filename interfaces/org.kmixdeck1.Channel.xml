<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <!-- /org/kmixdeck1/channel/<slug> : an input group applications play into (PipeWire null sink) -->
  <interface name="org.kmixdeck1.Channel">
    <property name="Slug" type="s" access="read"/>
    <property name="Name" type="s" access="readwrite"/>
    <property name="Icon" type="s" access="readwrite"/>
    <!-- channel-wide trim before all mixes, linear 0..1 (CH-7); NOT the per-mix fader -->
    <property name="Trim" type="d" access="readwrite"/>
    <property name="Muted" type="b" access="readwrite"/>
    <!-- PipeWire node.name, for tools that want to link things themselves -->
    <property name="NodeName" type="s" access="read"/>
    <!-- atomic mute toggle: what a hotkey or a Stream Deck key calls (no read-modify-write race) -->
    <method name="ToggleMute"/>
  </interface>
</node>
